generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  name           String?
  fullName       String?
  googleId       String?         @unique
  passwordHash   String
  role           UserRole        @default(STUDENT)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  examSessions   ExamSession[]
  certificates   Certificate[]
  payments       Payment[]
  coupons        WhatsAppCoupon[]
  enrollments    Enrollment[]
  legacySupportTickets LegacySupportTicket[]
  courseProgress CourseProgress[]
  lessonProgress LessonProgress[]
}

model Enrollment {
  id         Int      @id @default(autoincrement())
  userId     Int
  courseSlug String
  enrolledAt DateTime @default(now())
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course  @relation(fields: [courseSlug], references: [slug], onDelete: Cascade)

  @@unique([userId, courseSlug])
  @@index([userId])
}

model Course {
  id             Int             @id @default(autoincrement())
  slug           String          @unique
  title          String
  description    String?
  category       CourseCategory
  price          Decimal         @default(999) @db.Decimal(10, 2)
  isPublished    Boolean         @default(false)
  isTrending     Boolean         @default(false)
  ranking        Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  exams          Exam[]
  videos         YouTubeVideo[]
  payments       Payment[]
  enrollments    Enrollment[]
  legacySupportTickets LegacySupportTicket[]
  resources      Resource[]
  lessons        Lesson[]
  courseProgress CourseProgress[]
  certificates   Certificate[]
}

model Lesson {
  id                Int      @id @default(autoincrement())
  courseId          Int
  title             String
  description       String?
  hasVideo          Boolean  @default(false)
  slideUrls         String[] @default([])
  documentUrl       String?
  isPdfDocument     Boolean  @default(false)
  pdfPageCount      Int      @default(1)
  contentWordCount  Int      @default(0)
  estimatedReadTime Int      @default(600)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress          LessonProgress[]

  @@index([courseId])
}

model CourseProgress {
  id            Int      @id @default(autoincrement())
  userId        Int
  courseId      Int
  watchedSeconds Int     @default(0)
  readingSeconds Int     @default(0)
  points        Int      @default(0)
  isCompleted   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model LessonProgress {
  id            Int      @id @default(autoincrement())
  userId        Int
  lessonId      Int
  viewedSeconds Int      @default(0)
  lastActivityAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model Resource {
  id           Int          @id @default(autoincrement())
  courseId     Int
  title        String
  category     CourseCategory
  contentType  ResourceType
  sourceUrl    String
  uploadedBy   Int
  createdAt    DateTime     @default(now())
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, contentType])
}

model LegacySupportTicket {
  id          Int          @id @default(autoincrement())
  userId      Int
  courseId    Int?
  subject     String
  message     String
  status      TicketStatus @default(OPEN)
  adminNote   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("SupportTicket")
}

model SupportTicket {
  id          String           @id @default(cuid())
  userId      String?
  userName    String           @default("Student")
  userEmail   String?
  subject     String           @default("Help Desk conversation")
  status      ChatTicketStatus @default(OPEN)
  isAiHandled Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  messages    SupportMessage[]

  @@index([status, updatedAt])
  @@index([userId, updatedAt])
  @@index([userEmail, updatedAt])
  @@map("HelpDeskTicket")
}

model SupportMessage {
  id        String       @id @default(cuid())
  ticketId  String
  sender    ChatSender
  content   String
  createdAt DateTime     @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model Exam {
  id             Int             @id @default(autoincrement())
  courseId       Int
  title          String
  description    String?
  durationMin    Int             @default(60)
  passingScore   Int             @default(70)
  isPublished    Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  course         Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions      Question[]
  sessions        ExamSession[]
  certificates   Certificate[]

  @@index([courseId])
  @@unique([courseId, title])
}

model Question {
  id             Int             @id @default(autoincrement())
  examId         Int
  text           String
  options        Json
  correctAnswer  String
  explanation    String?
  points         Int             @default(1)
  exam           Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
}

model ExamSession {
  id             Int             @id @default(autoincrement())
  userId         Int
  examId         Int
  score          Int?
  answers        Json?
  startedAt      DateTime        @default(now())
  completedAt    DateTime?
  status         SessionStatus   @default(IN_PROGRESS)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam           Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  certificate    Certificate?
  questionOrder  Json?
  deadlineAt     DateTime?
  warnings       Int             @default(0)
  locked         Boolean         @default(false)
  attemptNumber  Int             @default(1)

  @@index([userId])
  @@index([examId])
}

model Certificate {
  id              Int               @id @default(autoincrement())
  certificateNo   String            @unique
  userId          Int
  examId          Int
  courseId        Int
  sessionId       Int               @unique
  status          CertificateStatus @default(PENDING_APPROVAL)
  issuedAt        DateTime          @default(now())
  expiresAt       DateTime?
  verificationHash String           @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam            Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  course          Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session         ExamSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([examId])
}

model WhatsAppCoupon {
  id             Int             @id @default(autoincrement())
  code           String          @unique
  phoneNumber    String
  userId         Int?
  discount       Decimal         @db.Decimal(10, 2)
  expiresAt      DateTime?
  redeemedAt     DateTime?
  createdAt      DateTime        @default(now())
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phoneNumber])
  @@index([userId])
}

model Payment {
  id             Int             @id @default(autoincrement())
  userId         Int
  courseId       Int
  amount         Decimal         @db.Decimal(10, 2)
  currency       String          @default("INR")
  provider       String?
  transactionId  String?         @unique
  status         PaymentStatus   @default(PENDING)
  method         PaymentMethod   @default(BANK_TRANSFER)
  reference      String?
  proofUrl       String?
  reviewNote     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
}

model YouTubeVideo {
  id             Int             @id @default(autoincrement())
  courseId       Int
  videoId        String          @unique
  title          String
  description    String?
  position       Int             @default(0)
  hook           String?
  attribution   String?
  durationSeconds Int            @default(600)
  isPublished    Boolean         @default(false)
  createdAt      DateTime        @default(now())
  course         Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, position])
}

enum UserRole {
  STUDENT
  ADMIN
}

enum CourseCategory {
  MICROSOFT
  AMAZON_ECOMMERCE
  AI_ML
  DIGITAL_MARKETING_SHOPIFY
  MEDICAL_HEALTH
  GYM_FITNESS
}

enum SessionStatus {
  IN_PROGRESS
  PASSED
  FAILED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum CertificateStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum PaymentMethod {
  MEEZAN_BANK
  UPAISA_NAYAPAY
  SECONDARY_WALLET
  CITIBANK_WIRE
  JAZZCASH
  BANK_TRANSFER
  USDT_TRON
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum ChatTicketStatus {
  OPEN
  RESOLVED
}

enum ChatSender {
  USER
  AI
  ADMIN
}

enum ResourceType {
  YOUTUBE
  PDF
}
